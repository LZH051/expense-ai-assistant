# 原命令行SQLite数据库
SQLITE_DB_PATH=database/expense_ai.db

# AI配置：仅在需要重新调用时填写
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-2-0-lite-260428

# Web版数据库。本地留空时使用 database/web_expense.db；
# Vercel线上必须填写云端PostgreSQL连接地址。
DATABASE_URL=

# Web登录会话签名密钥。线上必须替换为随机长字符串，禁止提交真实值。
SESSION_SECRET=
